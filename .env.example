# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/targets_timelines?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Config (RS256 asymmetric keys)
# Generate keys:
# ssh-keygen -t rsa -b 2048 -m PEM -f jwt.key
# openssl rsa -in jwt.key -pubout -outform PEM -out jwt.key.pub
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# MFA Secrets Encryption Key (32-byte hex for AES-256-GCM)
MFA_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# SMTP Mail (Fallback logs to console if empty)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="password"
SMTP_FROM="noreply@targets.com"

# App
PORT=3000
FRONTEND_URL="http://localhost:5173"
