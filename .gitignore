# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
out/

# TypeScript incremental build info
*.tsbuildinfo

# Environment files (sensitive credentials)
.env
.env.local
.env.*
*.env

# RSA JWT Private/Public Keys
jwt.key
jwt.key.pub
*.key
*.key.pub
*.pub
*.pem

# Redis database dump
dump.rdb

# Logs
*.log
logs/

# Generated Reports (PDF outputs)
apps/api/reports/

# Test & Coverage outputs
coverage/
.nyc_output/

# Puppeteer / Browser cache
.cache/
apps/api/.cache/

# Prisma generated client (rebuilt on install)
apps/api/node_modules/.prisma/

# Scratch / temp files
apps/api/test-report.ts
*.tmp
*.temp
scratch_*.js
apps/api/scratch_*.js
scratch/

# Editor & System Files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Antigravity IDE
.gemini/
.antigravityignore

# Temporary DB / test scripts
apps/api/prisma/inspect-db.ts
apps/api/prisma/delete-dummy-users.ts
apps/api/prisma/grant-*.ts
apps/api/prisma/reset-*.ts
apps/api/prisma/test-*.ts
apps/api/prisma/verify-*.ts
apps/api/prisma/restore_data.ts
apps/api/prisma/remove_dummy_data.ts

# Agent Customizations
.agents/

# Temporary PDF Exports
apps/api/tmp/
tmp/

# Local environment overrides
.env.*.local
.env.local

# Vite cache
apps/web/.vite/
**/.vite/

# Prisma generated client (root level)
apps/api/src/generated/

# Package manager lock files (keep one, ignore others)
